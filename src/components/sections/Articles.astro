---
import Section from "@/components/shared/organisms/Section.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import { resolveArticles } from "@/lib/articles";
import { useTranslations, type Locale } from "@/i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const articles = await resolveArticles(lang);
---

<Section id="articles" subtitle={t.sections.articles.subtitle} title={t.sections.articles.title}>
  <div class="grid" id="articles-grid" data-spotlight>
    {
      articles.map((article) => (
        <ArticleCard
          title={article.entry.data.title}
          subtitle={article.entry.data.subtitle}
          date={article.entry.data.date}
          tags={article.entry.data.tags}
          href={article.url}
          lang={lang}
          contentLang={article.contentLang}
          isFallback={article.isFallback}
        />
      ))
    }
  </div>
</Section>

<script>
  import { spotlight } from "@/lib/dom/spotlight";

  let cleanup: (() => void) | null = null;

  document.addEventListener("astro:before-swap", () => { cleanup?.(); cleanup = null; });
  function init() {
    const container = document.getElementById("articles-grid");
    if (container) cleanup = spotlight(container);
  }
  document.addEventListener("astro:page-load", init);
  init();
</script>

<style lang="scss">
  :global(#articles) {
    --accent-color: var(--orange);
    --accent-bright: var(--orange-dark);
    --secondary-accent-color: var(--orange-light);
    --accent-tint: var(--orange-tint);
    --accent-cool-shift: var(--orange-cool-shift);
    --accent-readable: var(--orange-readable);
  }

  .grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
</style>
