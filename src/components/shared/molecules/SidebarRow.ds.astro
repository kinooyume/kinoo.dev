---
import SidebarRowComponent from "./SidebarRow.astro";
import DSBlock from "@/components/design-system/DSBlock.astro";
import DSPreview from "@/components/design-system/DSPreview.astro";
import DSCode from "@/components/design-system/DSCode.astro";
import DSPropsTable from "@/components/design-system/DSPropsTable.astro";
import DSNote from "@/components/design-system/DSNote.astro";
import DSSectionHeader from "@/components/design-system/DSSectionHeader.astro";
import globe from "@/svgs/globe.svg?raw";
import github from "@/svgs/github.svg?raw";
---

<section id="sidebarrow">
  <DSSectionHeader title="SidebarRow" atomic="Molecule" framework="astro" />
  <p>A row in the mobile drawer lists. Icon, label, and an optional current value pushed to the right.</p>

  <DSBlock title="Preview">
    <DSPreview>
      <div class="row-demo">
        <SidebarRowComponent href="#" label="Langue" value="Français">
          <span slot="icon" class="sidebar-row-icon" set:html={globe} />
        </SidebarRowComponent>
        <SidebarRowComponent href="#" label="GitHub" external>
          <span slot="icon" class="sidebar-row-icon" set:html={github} />
        </SidebarRowComponent>
        <SidebarRowComponent href="#" label="Design System" />
      </div>
    </DSPreview>
    <DSCode inline>&lt;SidebarRow href="/x" label="Langue" value="Français" /&gt;</DSCode>
  </DSBlock>

  <DSBlock title="Props">
    <DSPropsTable
      headers={["Prop", "Type", "Description"]}
      rows={[
        ["href", { code: "string" }, "Link target"],
        ["label", { code: "string" }, "Row label, on the left"],
        ["value", { code: "string?" }, "Current state, right aligned and muted. Omit for a plain destination"],
        ["external", { code: "boolean?" }, "Adds target blank and the rel attributes"],
        ["…rest", { code: "unknown" }, "Forwarded to the anchor: aria-label, hreflang, data attributes"],
      ]}
    />
  </DSBlock>

  <DSBlock title="Slots">
    <DSPropsTable
      headers={["Slot", "Description"]}
      rows={[
        ["icon", "One or more spans carrying the sidebar-row-icon class. A slot rather than a prop so the theme row can hold both its sun and its moon"],
      ]}
    />
  </DSBlock>

  <DSBlock title="Value rows">
    <DSNote>
      A row with a value reads as a setting rather than a destination: the label
      says what it controls, the value says where it currently stands. Without it,
      a lone "Français" in a list of links reads as a label, not as a control.
    </DSNote>
    <DSNote>
      The value is aria-hidden. The anchor carries an aria-label naming both the
      state and the action, so a screen reader gets one sentence instead of two
      loose fragments.
    </DSNote>
    <DSNote>
      For a value that only the client knows, such as the theme, render the
      default and let the drawer script correct it. The drawer is off screen
      until opened, so the correction is never seen.
    </DSNote>
  </DSBlock>
</section>

<style lang="scss">
  .row-demo {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 280px;
  }
</style>
