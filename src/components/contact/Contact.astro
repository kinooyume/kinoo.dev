---
import ContactForm from "./ContactForm.tsx";
import RevealText from "@/components/shared/atoms/RevealText/RevealText.astro";
import Button from "@/components/shared/atoms/Button";
import linkedin from "@/svgs/linkedin.svg?raw";
import { useTranslations, type Locale } from "@/i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" data-animate-section>
  <RevealText text={t.contact.subtitle} as="span" class="subtitle" trigger="reveal:section:contact" />
  <RevealText text={t.contact.title} as="h2" class="display-heading" trigger="reveal:section:contact" />
  <div class="contact-content">
    <div class="contact-description">
      <p>{t.contact.intro}</p>
      <br />
      <p>{t.contact.outro}</p>
      <Button href="https://www.linkedin.com/in/martin-kinoo/" variant="tint" icon={linkedin} external client:load>{t.contact.linkedin}</Button>
    </div>
    <ContactForm
      client:load
      accessToken={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY}
      labels={t.contact.form}
      toasts={t.contact.toast}
    />
  </div>
</section>

<style lang="scss">
  section {
    margin: var(--section-margin) 0;

    :global(.subtitle) {
      display: block;
      color: var(--accent-color);
      font-weight: 300;
      font-size: var(--subtitle-size);
      margin: 0;
    }

    :global(h2) {
      display: block;
      overflow: hidden;
      padding-bottom: 0.15em;
    }
  }

  .contact-description {
    p {
      font-size: var(--hero-font-size);
      font-weight: 300;
      margin-bottom: 0;
    }

    :global(a) {
      margin-top: 24px;
    }
  }

  .contact-content {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(24px, 1.24rem + 1.13vw, 36px);
    align-items: start;
  }

  @media screen and (max-width: 1024px) {
    .contact-content {
      grid-template-columns: 1fr;
    }
  }
</style>
