---
import Button from "@/components/shared/atoms/Button";
import ThemeToggle from "./ThemeToggle.astro";
import LangToggle from "./LangToggle.astro";
import { localizePath, useTranslations, type Locale } from "@/i18n";

interface Props {
  lang: Locale;
  alternateHref?: string;
}

const { lang, alternateHref } = Astro.props;
const t = useTranslations(lang);

const isDesignSystem = Astro.url.pathname.startsWith("/design-system");
---

<div class="header-menu">
  {!isDesignSystem && <LangToggle lang={lang} href={alternateHref} />}
  <ThemeToggle lang={lang} />
  <Button href={`${localizePath("/", lang)}#contact`}>{t.nav.cta}</Button>
</div>

<style lang="scss">
  @use "@/styles/breakpoints" as *;

  .header-menu {
    display: flex;
    align-items: center;
    gap: 24px;
    opacity: 0;
  }

  @include wide {
    .header-menu {
      display: none;
    }
  }
</style>
