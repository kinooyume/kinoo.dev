---
import globe from "@/svgs/globe.svg?raw";
import { alternatePath, useTranslations, type Locale } from "@/i18n";

interface Props {
  lang: Locale;
  /** Cible explicite quand l'URL de l'autre langue ne se deduit pas du pathname. */
  href?: string;
}

const { lang, href: explicitHref } = Astro.props;
const t = useTranslations(lang);

const target: Locale = lang === "fr" ? "en" : "fr";
const href = explicitHref ?? alternatePath(Astro.url.pathname, target);
---

<a class="lang-toggle" href={href} hreflang={target} aria-label={t.a11y.langToggle}>
  <span class="lang-icon" aria-hidden="true" set:html={globe} />
  <span class="lang-code" aria-hidden="true">{lang.toUpperCase()}</span>
</a>

<style lang="scss">
  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 22px;
    color: var(--color);
    opacity: var(--opacity-muted);
    text-decoration: none;
    transition: opacity var(--transition-base), color var(--transition-base);

    &:hover {
      opacity: 1;
      color: var(--accent-color);
    }
  }

  .lang-icon {
    display: flex;
    align-items: center;

    :global(svg) {
      width: 17px;
      height: 17px;
    }
  }

  .lang-code {
    font-size: var(--font-size-3xs);
    font-weight: 500;
    letter-spacing: 0.5px;
    line-height: 1;
  }
</style>
