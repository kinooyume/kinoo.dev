---
import cv from "@/svgs/cv.svg?raw";
import github from "@/svgs/github.svg?raw";
import linkedin from "@/svgs/linkedin.svg?raw";
import terminal from "@/svgs/terminal.svg?raw";
import sun from "@/svgs/sun.svg?raw";
import moon from "@/svgs/moon.svg?raw";
import globe from "@/svgs/globe.svg?raw";
import {
  alternatePath,
  localizePath,
  useTranslations,
  type Locale,
} from "@/i18n";

interface Props {
  lang: Locale;
  alternateHref?: string;
}

const { lang, alternateHref } = Astro.props;
const t = useTranslations(lang);
const home = localizePath("/", lang);

const sections = [
  { label: t.nav.articles, href: `${home}#articles`, color: "var(--orange)" },
  { label: t.nav.realisations, href: `${home}#realisations`, color: "var(--green)" },
  { label: t.nav.experiences, href: `${home}#experiences`, color: "var(--pink)" },
  { label: t.nav.formations, href: `${home}#formations`, color: "var(--purple)" },
  { label: t.nav.contact, href: `${home}#contact`, color: "var(--accent-color)" },
];

const otherLang: Locale = lang === "fr" ? "en" : "fr";
const langHref = alternateHref ?? alternatePath(Astro.url.pathname, otherLang);
---

<div class="mobile-sidebar">
  <div class="mobile-sidebar-header">
    <a href={home} class="mobile-sidebar-logo">
      <span class="mobile-sidebar-logo-icon" set:html={terminal} />
      Martin Kinoo
    </a>
  </div>

  <nav class="mobile-sidebar-nav">
    {
      sections.map((section) => (
        <a href={section.href} style={`--section-color: ${section.color};`}>
          <span class="nav-indicator" />
          {section.label}
        </a>
      ))
    }
  </nav>

  <hr class="mobile-sidebar-divider" />

  <div class="mobile-sidebar-links">
    <a href="/design-system">{t.nav.designSystem}</a>
  </div>

  <hr class="mobile-sidebar-divider" />

  <div class="mobile-sidebar-links">
    <a href="#" data-theme-row>
      <span class="link-icon theme-icon-sun" set:html={sun} />
      <span class="link-icon theme-icon-moon" set:html={moon} />
      {t.nav.theme}
    </a>
    <a href={langHref} hreflang={otherLang} aria-label={t.a11y.langToggle}>
      <span class="link-icon" aria-hidden="true" set:html={globe} />
      {t.nav.language}
    </a>
  </div>

  <hr class="mobile-sidebar-divider" />

  <div class="mobile-sidebar-links">
    <a
      href="/MartinKinooCV.pdf"
      target="_blank"
      rel="noreferrer nofollow noopener"
    >
      <span class="link-icon" set:html={cv} />
      CV
    </a>
    <a
      href="https://github.com/KinooYume"
      target="_blank"
      rel="noreferrer nofollow noopener"
    >
      <span class="link-icon" set:html={github} />
      GitHub
    </a>
    <a
      href="https://www.linkedin.com/in/martin-kinoo/"
      target="_blank"
      rel="noreferrer nofollow noopener"
    >
      <span class="link-icon" set:html={linkedin} />
      LinkedIn
    </a>
  </div>
</div>

<script>
  import { getTheme, toggleTheme } from "@/lib/theme";

  function syncThemeIcons(row: HTMLElement) {
    const isDark = getTheme() === "dark";
    const sun = row.querySelector<HTMLElement>(".theme-icon-sun");
    const moon = row.querySelector<HTMLElement>(".theme-icon-moon");
    if (sun) sun.style.display = isDark ? "none" : "flex";
    if (moon) moon.style.display = isDark ? "flex" : "none";
  }

  function initThemeRow() {
    document.querySelectorAll<HTMLElement>("[data-theme-row]").forEach((row) => {
      if (row.dataset.bound) return;
      row.dataset.bound = "true";
      syncThemeIcons(row);
      row.addEventListener("click", (e) => {
        e.preventDefault();
        toggleTheme();
        syncThemeIcons(row);
      });
    });
  }

  document.addEventListener("astro:page-load", initThemeRow);
  initThemeRow();
</script>

<style lang="scss">
  .mobile-sidebar {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mobile-sidebar-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-color);
  }

  .mobile-sidebar-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-size: 20px;
    font-weight: 300;
    color: var(--light-color);
  }

  .mobile-sidebar-logo-icon {
    display: flex;
    align-items: center;
    margin-top: 4px;

    :global(svg) {
      width: 20px;
      height: 20px;
    }
  }

  .mobile-sidebar-meta-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    font-size: 14px;
    font-weight: 400;
    color: var(--color);
    text-decoration: none;
    transition: all 0.2s ease;

    &:hover {
      color: var(--accent-color);
    }
  }

  .mobile-sidebar-title {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--light-color);
    opacity: 0.6;
  }

  .mobile-sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;

    a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 400;
      color: var(--light-color);
      text-decoration: none;
      transition: all 0.2s ease;

      &:hover {
        background-color: var(--border-color);
        color: var(--section-color);
      }
    }
  }

  .nav-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--section-color);
    opacity: 0.8;
  }

  .mobile-sidebar-divider {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 8px 0;
  }

  .mobile-sidebar-links {
    display: flex;
    flex-direction: column;
    gap: 4px;

    a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 400;
      color: var(--color);
      text-decoration: none;
      transition: all 0.2s ease;

      &:hover {
        background-color: var(--border-color);
        color: var(--accent-color);
      }
    }
  }

  .link-icon {
    display: flex;
    align-items: center;
    opacity: 0.7;

    :global(svg) {
      width: 16px;
      height: 16px;
    }
  }
</style>
