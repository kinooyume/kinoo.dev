---
import Link from "@/components/shared/atoms/Link.astro";
import { useTranslations, type Locale } from "@/i18n";

interface Props {
  lang: Locale;
  contentLang: Locale;
  href: string;
}

const { lang, contentLang, href } = Astro.props;
const t = useTranslations(lang);
---

<aside class="language-notice">
  <p>
    <span class="code" aria-hidden="true" lang={contentLang}>{contentLang.toUpperCase()}</span>
    {t.article.fallbackNotice}{" "}
    <Link href={href} text={t.article.fallbackLink} small />
  </p>
</aside>

<style lang="scss">
  .language-notice {
    margin-bottom: 32px;
    padding: 12px 16px;
    border: 1px solid var(--border-color);
    border-left: 2px solid var(--accent-color);
    /* Les coins carres du cote de la barre la gardent droite d'un bout a
       l'autre, comme le blockquote des articles. */
    border-radius: 0 8px 8px 0;
    background-color: var(--card-surface);
  }

  p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .code {
    display: inline-block;
    vertical-align: middle;
    /* Correction optique : moitie de l'ecart de hauteur de capitale entre le
       label de 11px et le texte de 15px a cote. Sans elle le label partage la
       ligne de base du voisin et sa masse visuelle tombe trop bas. */
    position: relative;
    top: -1.5px;
    margin-right: 6px;
    padding: 2px 6px;
    /* Sans ca, .code herite du line-height 1.5 du paragraphe : la boite fait
       18px pour un texte de 11px, et ce demi-interligne la decale vers le haut. */
    line-height: 1;
    border-radius: 4px;
    background-color: var(--accent-tint);
    color: var(--accent-bright);
    font-size: var(--font-size-4xs);
    font-weight: 600;
    letter-spacing: 0.5px;
  }
</style>
