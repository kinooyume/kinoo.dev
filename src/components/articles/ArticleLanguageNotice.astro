---
import Link from "@/components/shared/atoms/Link.astro";
import { useTranslations, type Locale } from "@/i18n";

interface Props {
  lang: Locale;
  contentLang: Locale;
  href: string;
}

const { lang, contentLang, href } = Astro.props;
const t = useTranslations(lang);
---

<aside class="language-notice">
  <p>
    <span class="code" aria-hidden="true" lang={contentLang}>{contentLang.toUpperCase()}</span>
    {t.article.fallbackNotice}{" "}
    <Link href={href} text={t.article.fallbackLink} small />
  </p>
</aside>

<style lang="scss">
  .language-notice {
    margin-bottom: 32px;
    padding: 12px 16px;
    border: 1px solid var(--border-color);
    border-left: 2px solid var(--accent-color);
    /* Square corners on the bar's own side keep the line straight end to end,
       the same treatment as the article blockquote. */
    border-radius: 0 8px 8px 0;
    background-color: var(--card-surface);
  }

  p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .code {
    display: inline-block;
    vertical-align: middle;
    /* Optical correction: half the cap height difference between the 11px label
       and the 15px text beside it. Without it the label shares its neighbour's
       baseline and its visual mass falls too low. */
    position: relative;
    top: -1.5px;
    margin-right: 6px;
    padding: 2px 6px;
    /* Without this, .code inherits the paragraph's 1.5 line-height: an 18px box
       around 11px text, and that half leading pushes it up. */
    line-height: 1;
    border-radius: 4px;
    background-color: var(--accent-tint);
    color: var(--accent-bright);
    font-size: var(--font-size-4xs);
    font-weight: 600;
    letter-spacing: 0.5px;
  }
</style>
