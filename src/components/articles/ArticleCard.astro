---
import Spotlight from "@/components/shared/molecules/Spotlight.astro";
import Card from "@/components/shared/molecules/Card/Card.astro";
import CardContent from "@/components/shared/molecules/Card/CardContent.astro";
import CardDescription from "@/components/shared/molecules/Card/CardDescription.astro";
import TagRow from "@/components/shared/atoms/TagRow.astro";
import Tag from "@/components/shared/atoms/Tag.astro";
import arrowRight from "@/svgs/arrow.svg?raw";
import { accentInlineStyle } from "@/lib/categoryColors";
import { formatDate, useTranslations, type Locale } from "@/i18n";

interface Props {
  title: string;
  subtitle?: string;
  date: Date;
  tags: string[];
  href: string;
  category?: string;
  lang?: Locale;
  contentLang?: Locale;
  isFallback?: boolean;
}

const {
  title,
  subtitle,
  date,
  tags,
  href,
  category,
  lang = "fr",
  contentLang = lang,
  isFallback = false,
} = Astro.props;

const t = useTranslations(lang);
const formattedDate = formatDate(date, lang);
const label = isFallback ? `${title} (${t.article.inOtherLanguage})` : title;
---

<a href={href} class="article-card-link" aria-label={label} style={accentInlineStyle(category)}>
  <Spotlight color="var(--accent-color)">
    <Card>
      <CardContent>
        <div slot="title" class="article-title">
          <div class="article-title-meta">
            <time datetime={date.toISOString()}>{formattedDate}</time>
            {isFallback && (
              <Tag title={contentLang.toUpperCase()} size="small" outline />
            )}
          </div>
          <h3>{title}<span class="arrow" aria-hidden="true" set:html={arrowRight} /></h3>
        </div>
        {subtitle && (
          <CardDescription>
            <p>{subtitle}</p>
          </CardDescription>
        )}
        {tags.length > 0 && (
          <TagRow class="article-card-tags">
            {tags.map((tag) => <Tag title={tag} />)}
          </TagRow>
        )}
      </CardContent>
    </Card>
  </Spotlight>
</a>

<style lang="scss">
  .article-card-link {
    text-decoration: none;
    display: block;
  }

  time {
    font-size: var(--font-size-xs);
    color: var(--text-muted);
  }

  .article-title-meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  /* Tag takes no class prop, so the marker is sized from here. The selector has
     to stay global all the way down: the span is rendered by Tag and carries
     none of this component's scope. */
  .article-title-meta :global(.tag) {
    padding: 2px 6px;
    /* Optical correction: half the cap height difference between the 11px label
       and the 15px text beside it. Without it the label shares its neighbour's
       baseline and its visual mass falls too low. */
    position: relative;
    top: -1.5px;
  }

  /* .small is required here: without it Tag's own rule
     (div[cid].small span[cid]) is more specific and wins. */
  .article-title-meta :global(.tag.small span) {
    font-size: var(--font-size-4xs);
    /* Without this the span inherits the card's leading and the chip grows to
       twice the height of the date beside it. */
    line-height: 1;
  }

  .article-card-tags {
    padding-top: 16px;
  }

  h3 {
    margin: 8px 0 0;

    .arrow {
      display: inline-flex;
      align-items: center;
      vertical-align: middle;
      margin-left: 8px;
      opacity: 0;
      transform: translateX(-4px) translateY(-0.1em);
      transition: all 0.2s ease;

      :global(svg) {
        width: 0.5em;
        height: 0.5em;
        fill: currentColor;
      }
    }
  }

  .article-card-link:hover h3 .arrow {
    opacity: 1;
    transform: translateX(0) translateY(-0.1em);
  }
</style>
