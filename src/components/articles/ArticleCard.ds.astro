---
import DSBlock from "@/components/design-system/DSBlock.astro";
import DSPreview from "@/components/design-system/DSPreview.astro";
import DSCode from "@/components/design-system/DSCode.astro";
import DSPropsTable from "@/components/design-system/DSPropsTable.astro";
import DSStructure from "@/components/design-system/DSStructure.astro";
import DSNote from "@/components/design-system/DSNote.astro";
import DSSectionHeader from "@/components/design-system/DSSectionHeader.astro";
import ArticleCardComponent from "./ArticleCard.astro";
---

<section id="articlecard">
  <DSSectionHeader title="ArticleCard" atomic="Molecule" framework="astro" />
  <p>Article listing card. Same composition as Experience Card (Spotlight → Card → CardContent → CardDescription) wrapped in a link.</p>

  <DSBlock title="Preview">
    <DSPreview>
      <div data-spotlight style="max-width: 720px;">
        <ArticleCardComponent
          title="Event-based approach instead of global state"
          subtitle="A one-shot event bus to coordinate animation lifecycle signals between decoupled components."
          date={new Date("2025-01-15")}
          tags={["architecture", "typescript"]}
          href="#"
        />
      </div>
    </DSPreview>
    <DSCode inline>&lt;ArticleCard title="…" subtitle="…" date={new Date()} tags={["tag"]} href="/articles/slug" /&gt;</DSCode>
  </DSBlock>

  <DSBlock title="Untranslated article">
    <DSPreview>
      <div data-spotlight style="max-width: 720px;">
        <ArticleCardComponent
          title="Rendering large lists"
          subtitle="Virtualisation, windowing, and when neither is worth the complexity."
          date={new Date("2025-03-02")}
          tags={["performance"]}
          href="#"
          lang="fr"
          contentLang="en"
          isFallback
        />
      </div>
    </DSPreview>
    <DSNote>
      The language tag marks a card whose article is served in the other
      language. The locale is also appended to the link aria-label, so the
      information reaches screen readers and not only sighted users.
    </DSNote>
    <DSNote>
      The row aligns on the baseline, not on centre. Centring puts the chip on
      the middle of the date's line box, which reserves descender space no digit
      uses, so the chip ended up sitting above the date. The chip also resets
      line-height, or it inherits the card's and grows to twice the height of
      the text it sits next to.
    </DSNote>
    <DSNote>
      A 1.5px optical raise sits on top of that. Sharing a baseline is not the
      same as looking aligned: an 11px label has a shorter cap height than the
      15px text beside it, so its visual mass falls low. The correction is half
      that difference, measured on the rendered page.
    </DSNote>
  </DSBlock>

  <DSBlock title="Structure">
    <DSStructure
      rows={[
        { code: "<a>", description: "Link wrapper" },
        { code: "Spotlight", description: "Hover glow effect", indent: 1 },
        { code: "Card", description: "Shared card shell (.text-sm)", indent: 2 },
        { code: "CardContent", description: "Title + body layout", indent: 3 },
        { code: "slot=\"title\"", description: "Meta row + h3 with hover arrow", indent: 4 },
        { code: ".article-title-meta", description: "Date and language marker, side by side", indent: 5 },
        { code: "Tag", description: "Language marker, fallback only", indent: 6 },
        { code: "CardDescription", description: "Subtitle text (shared styles)", indent: 4 },
        { code: "TagRow", description: "Tag list", indent: 4 },
      ]}
    />
  </DSBlock>

  <DSBlock title="Props">
    <DSPropsTable
      headers={["Prop", "Type", "Description"]}
      rows={[
        ["title", { code: "string" }, "Article title"],
        ["subtitle", { code: "string?" }, "Short subtitle"],
        ["date", { code: "Date" }, "Publication date"],
        ["tags", { code: "string[]" }, "Tag labels"],
        ["href", { code: "string" }, "Link to the article"],
        ["lang", { code: "Locale?" }, "Page locale. Drives date formatting. Defaults to fr"],
        ["contentLang", { code: "Locale?" }, "Locale the article is written in. Defaults to lang"],
        ["isFallback", { code: "boolean?" }, "Shows the language tag and extends the aria-label"],
      ]}
    />
  </DSBlock>
</section>
