---
import { render } from "astro:content";
import BlogPostLayout from "@/layouts/BlogPostLayout.astro";
import { resolveArticles } from "@/lib/articles";

export async function getStaticPaths() {
  const articles = await resolveArticles("en");
  return articles.map((article) => ({
    params: { slug: article.url.replace("/en/articles/", "") },
    props: { article },
  }));
}

const { article } = Astro.props;
const { entry, contentLang, isFallback, sourceUrl, otherUrl, alternateUrl } = article;
const { Content } = await render(entry);
const ogImage = new URL(`/og/${entry.id}.png`, Astro.site).href;
---

<BlogPostLayout
  title={entry.data.title}
  subtitle={entry.data.subtitle}
  description={entry.data.description}
  date={entry.data.date}
  category={entry.data.category}
  tags={entry.data.tags}
  links={entry.data.links}
  ogImage={ogImage}
  lang="en"
  contentLang={contentLang}
  canonical={isFallback ? sourceUrl : article.url}
  localeUrls={{ fr: otherUrl, en: article.url }}
  alternates={alternateUrl !== null}
>
  <Content />
</BlogPostLayout>
